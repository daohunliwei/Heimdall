{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Heimdall": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "UseUtcTimestamp": false
      }
    }
  },
  "CodeFirst": {
    "AutoSync": true
  },
  "ModelTier": {
    "StructurePlanningModel": null,
    "PageGenerationModel": null,
    "QualityReviewModel": null,
    "DefaultProvider": null
  },
  "StructurePlanning": {
    "Strategy": "Deterministic"
  }
}
