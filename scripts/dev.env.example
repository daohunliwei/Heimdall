# Heimdall 品牌已由 DeepWiki 更名而来。
# 当前版本优先读取 HEIMDALL_* 新键名，同时兼容 DEEPWIKI_* 历史键名。
SERVER_BASE_URL=http://localhost:8001
ASPNETCORE_URLS=http://localhost:8001
ASPNETCORE_ENVIRONMENT=Development

# 如需集中维护后端配置，可先复制 scripts/backend.runtime.config.example.json 为 scripts/backend.runtime.config.json
HEIMDALL_RUNTIME_CONFIG_PATH=

HEIMDALL_AUTH_MODE=
HEIMDALL_AUTH_CODE=
HEIMDALL_DATA_DIR=
HEIMDALL_STORAGE_DIR=
HEIMDALL_CONFIG_DIR=
HEIMDALL_DEFAULT_PROVIDER=
HEIMDALL_EMBEDDER_TYPE=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_WORKSPACE_ID=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_VERSION=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_ROLE_ARN=

OLLAMA_HOST=
HEIMDALL_HTTP_TIMEOUT_MINUTES=180
HEIMDALL_WIKI_TASK_TIMEOUT_MINUTES=180
HEIMDALL_OLLAMA_REQUEST_TIMEOUT_MINUTES=60
