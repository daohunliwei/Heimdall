# Heimdall 开发环境变量（示例）
# 复制此文件为 dev.env 并按需修改
# cp dev.env.example dev.env

# ── 服务地址 ───────────────────────────────────────────
SERVER_BASE_URL=http://localhost:8001
ASPNETCORE_URLS=http://localhost:8001
ASPNETCORE_ENVIRONMENT=Development

# ── 数据库（PostgreSQL + pgvector） ───────────────────
HEIMDALL_CONNECTION_STRING=Host=localhost;Port=5432;Database=heimdall;Username=heimdall;Password=heimdall

# ── 认证 ──────────────────────────────────────────────
# none = 关闭认证，jwt = JWT Bearer 认证
HEIMDALL_AUTH_MODE=none
HEIMDALL_JWT_SECRET=change-me-in-production
HEIMDALL_JWT_EXPIRY_HOURS=72
HEIMDALL_REGISTRATION_OPEN=true

# ── 运行时配置（可选） ────────────────────────────────
# HEIMDALL_RUNTIME_CONFIG_PATH=

# ── AI 生成服务 ───────────────────────────────────────
HEIMDALL_DEFAULT_PROVIDER=ollama
# Ollama Chat 地址（默认 http://localhost:11434）
HEIMDALL_OLLAMA_CHAT_HOST=http://localhost:11434

# ── 向量化服务 ────────────────────────────────────────
HEIMDALL_EMBEDDER_TYPE=ollama
# Ollama Embed 地址（默认同 OLLAMA_HOST）
HEIMDALL_OLLAMA_EMBED_HOST=http://localhost:11434

# ── Provider 密钥（按需填写） ─────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_WORKSPACE_ID=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_VERSION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_ROLE_ARN=
OLLAMA_HOST=

# ── 超时配置（分钟） ──────────────────────────────────
HEIMDALL_HTTP_TIMEOUT_MINUTES=180
HEIMDALL_WIKI_TASK_TIMEOUT_MINUTES=180
HEIMDALL_OLLAMA_REQUEST_TIMEOUT_MINUTES=60
